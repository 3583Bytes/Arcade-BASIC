<Project>

  <PropertyGroup>
    <!-- Per-project: libs multi-target net9.0;netstandard2.1; CLI/tests use TargetFramework=net9.0. -->
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <RootNamespace>FullBasic.$(MSBuildProjectName.Replace('FullBasic.', ''))</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Verify.Xunit" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'true' AND '$(MSBuildProjectName)' != 'FullBasic.Cli'">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

  <!-- Compiler-feature polyfills (IsExternalInit, RequiredMember, etc.) on
       any non-.NET-5+ target. Only kicks in when a project actually
       multi-targets to netstandard / netframework. -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('netstandard')) OR $(TargetFramework.StartsWith('netcoreapp1')) OR $(TargetFramework.StartsWith('net4'))">
    <Compile Include="$(MSBuildThisFileDirectory)Polyfill.cs" Link="Polyfill.cs" />
  </ItemGroup>

</Project>
