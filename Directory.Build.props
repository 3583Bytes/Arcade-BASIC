<Project>

  <PropertyGroup>
    <!-- Per-project: libs multi-target net9.0;netstandard2.1; CLI/tests use TargetFramework=net9.0. -->
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <RootNamespace>ArcadeBasic.$(MSBuildProjectName.Replace('ArcadeBasic.', ''))</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Verify.Xunit" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'true' AND '$(MSBuildProjectName)' != 'ArcadeBasic.Cli'">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

  <!-- Compiler-feature polyfills (IsExternalInit, RequiredMember, etc.) on
       any non-.NET-5+ target. Only kicks in when a project actually
       multi-targets to netstandard / netframework. -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('netstandard')) OR $(TargetFramework.StartsWith('netcoreapp1')) OR $(TargetFramework.StartsWith('net4'))">
    <Compile Include="$(MSBuildThisFileDirectory)Polyfill.cs" Link="Polyfill.cs" />
  </ItemGroup>

  <!-- AOT-publish a multi-targeted lib only on its net9.0 build. When the CLI
       publishes with `-p:PublishAot=true`, MSBuild propagates that property to
       every transitively-referenced project, and the netstandard2.1 variant of
       each lib then errors out with NETSDK1207. Override here so the
       netstandard2.1 build path always opts out, regardless of caller. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

</Project>
