<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ArcadeBasic.Core\ArcadeBasic.Core.csproj" />
    <ProjectReference Include="..\ArcadeBasic.Parser\ArcadeBasic.Parser.csproj" />
    <ProjectReference Include="..\ArcadeBasic.Sema\ArcadeBasic.Sema.csproj" />
    <ProjectReference Include="..\ArcadeBasic.Compiler\ArcadeBasic.Compiler.csproj" />
    <ProjectReference Include="..\ArcadeBasic.Vm\ArcadeBasic.Vm.csproj" />
    <ProjectReference Include="..\ArcadeBasic.Lexer\ArcadeBasic.Lexer.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArcadeBasic.Cli</RootNamespace>
    <!-- Published binary name: the conventional CLI name on disk, so release
         artifacts only need a version+rid suffix appended. -->
    <AssemblyName>arcade-basic</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- A game's Info.plist and default icon, for the desktop build on macOS; the IDE's Export uses the same plist. -->
    <EmbeddedResource Include="..\..\desktop\player\app-Info.plist" LogicalName="app-Info.plist" />
    <EmbeddedResource Include="..\..\desktop\player\icons\icon.icns" LogicalName="icon.icns" />
  </ItemGroup>

</Project>
