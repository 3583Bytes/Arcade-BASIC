  FOR TT = 0 TO 8
    FOR Y = 0 TO TW - 1
      READ ROW$
      FOR X = 0 TO TW - 1
        IF MID$(ROW$, X + 1, 1) = "." THEN
          LET TEX(2 * TT, X, Y) = -1
          LET TEX(2 * TT + 1, X, Y) = -1
        ELSE
          LET C = VAL(MID$(ROW$, X + 1, 1))
          LET TEX(2 * TT, X, Y) = 16 + 8 * TT + C
          LET TEX(2 * TT + 1, X, Y) = 20 + 8 * TT + C
        END IF
      NEXT X
    NEXT Y
  NEXT TT
